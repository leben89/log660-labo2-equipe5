<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="ca.ets.log660.labo2.model">
    <class name="CarteCredit" table="CARTECREDIT">
        <id name="id" column="ID">
            <generator class="native"/>
        </id>
        <property name="carteType" column="CARTE_TYPE" not-null="true"/>
        <property name="numero" not-null="true" type="string">
            <column name="NUMERO" length="1" sql-type="char(1)"/>
        </property>
        <property name="expDate" column="EXP_DATE" not-null="true"/>
        <property name="cvv" column="CVV" not-null="true"/>
    </class>
</hibernate-mapping>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="ca.ets.log660.labo2.model">
    <class name="Location" table="LOCATION">
        <id name="id" column="ID">
            <generator class="native"/>
        </id>
        <many-to-one name="client" class="Client" column="CLIENT_ID" not-null="true"/>
        <set name="filmProduits" table="LOCATION_FILM_PRODUIT" cascade="none">
            <key column="LOCATION_ID"/>
            <many-to-many class="FilmProduit" column="FILM_PRODUIT_ID"/>
        </set>
    </class>
</hibernate-mapping>
